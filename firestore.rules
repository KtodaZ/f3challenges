rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin identity. There are NO custom claims by design: membership in
    // /admins/{authUid} is the single source of truth, so revoking an admin is
    // just deleting that doc and takes effect on the very next request.
    // exists() (not get()) because we need a boolean, not a document.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Fields only an admin may write. PAX are unauthenticated, so without this
    // anyone could archive anyone. `formerNames` is here for the same reason:
    // it reserves F3 names someone has been renamed away from, and clearing it
    // would let a historical @mention be re-pointed at a different person.
    function touchesAdminFields(keys) {
      return keys.hasAny(['status', 'archivedAt', 'archivedBy', 'formerNames']);
    }

    // Users: trust-based, no auth required. PAX writes (displayName, fcmTokens,
    // badges, achievements, streaks, notificationPreferences,
    // pendingCelebration, migratedAt, ...) stay wide open — create and update
    // are split only because diff() has no meaning on a create, where there is
    // no prior resource.data to diff against.
    match /users/{userId} {
      allow read: if true;

      allow create: if isAdmin()
        || !touchesAdminFields(request.resource.data.keys());

      // affectedKeys() covers removal as well as setting/changing a field —
      // intended: clearing `status` is just as privileged as setting it.
      allow update: if isAdmin()
        || !touchesAdminFields(
             request.resource.data.diff(resource.data).affectedKeys()
           );

      // Unchanged from the blanket rule this replaced: deletes were allowed
      // and the app has no delete path. Stated explicitly so it is a decision,
      // not an accident of rule ordering.
      allow delete: if true;
    }

    // Admin panel collections. No client access at all — the panel talks to
    // these through server routes using the Admin SDK, which bypasses rules.
    // Modeled on notificationLog below, but read is closed too: the admin
    // roster and audit trail are not public.
    match /admins/{uid} {
      allow read, write: if false;
    }

    match /adminAudit/{auditId} {
      allow read, write: if false;
    }

    match /adminBootstrap/{bootstrapId} {
      allow read, write: if false;
    }

    // Admins designated but not yet signed in. Closed to clients like the
    // rest: these rows are pending grants, so a client write would be a way to
    // make yourself an admin. Claiming happens server-side on the designee's
    // first Google sign-in (/api/admin/session).
    match /adminDesignations/{designationId} {
      allow read, write: if false;
    }

    // Unclaimed admin invites. Closed to clients like the rest — the invite
    // token is the doc id, so a client read would hand out working invite
    // links. Redemption goes through /api/admin/invites/claim.
    match /adminInvites/{token} {
      allow read, write: if false;
    }

    // Daily logs: readable and writable by all (trust-based)
    match /dailyLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Feed: readable and writable by all, but hard deletes are blocked
    // Use soft-delete pattern: set { deleted: true } instead of deleting docs
    match /feed/{postId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;

      // Comments subcollection — same soft-delete pattern
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if false;
      }
    }

    // Collection-group reads for comments (e.g. the Conversationalist badge
    // counts a user's comments via collectionGroup('comments')). Collection
    // group queries are NOT covered by the path-scoped /feed/.../comments rule
    // above — they require a recursive-wildcard match on the collection group.
    // Read-only: creates/updates still go through the path-scoped rule, and
    // hard deletes stay blocked (no rule grants delete).
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // Participation: readable and writable by all (trust-based)
    match /participation/{participationId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications: readable and writable by all (no auth to scope by userId)
    match /notifications/{userId}/items/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // Bonus logs: readable and writable by all (trust-based)
    match /bonusLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Feedback: bug reports and suggestions filed from Settings. Write-only for
    // clients — a PAX can file one but cannot read anyone's (feedback often
    // names other people, and a gripe filed in confidence shouldn't be public).
    // Triage reads and updates these with the Admin SDK, which bypasses rules.
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Notification log: readable for debugging, written only by Cloud Functions
    match /notificationLog/{logId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
